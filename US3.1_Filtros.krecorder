<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
<meta content="text/html; charset=UTF-8" http-equiv="content-type" />
<title>Untitled Test Suite</title>
</head>
<body>
<table cellpadding="1" cellspacing="1" border="1">
<thead>
<tr><td rowspan="1" colspan="3" data-tags="">Untitled Test Case</td></tr>
</thead>
<tbody>
<tr><td>open</td><td>https://alexandresousa24.github.io/rent-a-tool-web-app/#/<datalist><option>https://alexandresousa24.github.io/rent-a-tool-web-app/#/</option></datalist></td><td></td></tr>
<tr><td>click</td><td>name=category<datalist><option>name=category</option><option>xpath=//select[@name='category']</option><option>xpath=//form[@id='searchForm']/label[2]/select</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Categoria'])[1]/following::select[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Pesquisar'])[2]/following::select[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Cidade'])[1]/preceding::select[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Preço máx./dia (€)'])[1]/preceding::select[2]</option><option>xpath=//select</option><option>css=select[name="category"]</option></datalist></td><td></td></tr>
<tr><td>select</td><td>name=category<datalist><option>name=category</option><option>xpath=//select[@name='category']</option><option>xpath=//form[@id='searchForm']/label[2]/select</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Categoria'])[1]/following::select[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Pesquisar'])[2]/following::select[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Cidade'])[1]/preceding::select[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Preço máx./dia (€)'])[1]/preceding::select[2]</option><option>xpath=//select</option><option>css=select[name="category"]</option></datalist></td><td>label=Jardim</td></tr>
<tr><td>click</td><td>xpath=//button[@type='submit']<datalist><option>xpath=//button[@type='submit']</option><option>xpath=//form[@id='searchForm']/button</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Preço máx./dia (€)'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Cidade'])[1]/following::button[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Ferramentas disponíveis'])[1]/preceding::button[1]</option><option>xpath=//button</option><option>css=button.btn.btn--primary.search__submit</option></datalist></td><td></td></tr>
<tr><td>verifyText</td><td>xpath=//div[@id='catalogResults']/div/a[2]/div[2]/h3<datalist><option>xpath=//div[@id='catalogResults']/div/a[2]/div[2]/h3</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='/ dia'])[2]/following::h3[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='✓ Trusted'])[1]/following::h3[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Porto, Matosinhos'])[1]/preceding::h3[1]</option><option>xpath=(.//*[normalize-space(text()) and normalize-space(.)='Jardim'])[3]/preceding::h3[1]</option><option>xpath=//*/text()[normalize-space(.)='Soprador de folhas a gasolina']/parent::*</option><option>xpath=//a[2]/div[2]/h3</option></datalist></td><td>Soprador de folhas a gasolina</td></tr>
</tbody></table>
</body>
</html>